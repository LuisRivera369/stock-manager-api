generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum MovementType {
  IN
  OUT
}

model User {
  id        String          @id @default(uuid())
  email     String          @unique
  password  String
  role      Role            @default(EMPLOYEE)
  createdAt DateTime        @default(now())
  movements StockMovement[]

  @@map("users")
}

model Product {
  id          String          @id @default(uuid())
  name        String
  sku         String          @unique
  description String?
  price       Decimal        @db.Decimal(10, 2)
  stock       Int             @default(0)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]

  @@map("products")
}

model StockMovement {
  id        String       @id @default(uuid())
  type      MovementType
  quantity  Int
  reason    String?
  productId String
  userId    String
  createdAt DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}
