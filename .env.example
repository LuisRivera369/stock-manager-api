NODE_ENV=development
PORT=3000

# Motor de base de datos (opcional, default: postgresql)
# Disponible: postgresql, sqlite
# Si no se especifica, usa postgresql por defecto
DATABASE_PROVIDER=postgresql

# PostgreSQL local o servicio `db` de docker-compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_manager"
# Para SQLite: ruta al archivo (ej. file:./dev.db)
# DATABASE_URL=file:./dev.db

# Base de datos aislada para la suite (se crea y migra automaticamente)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/stock_manager_test"

# Motor de base de datos para tests (opcional, default: sqlite)
# Si no se especifica, usa sqlite para tests aisladados
DATABASE_PROVIDER_TEST=sqlite

# Credenciales del contenedor PostgreSQL (las usa docker-compose).
# Si las cambias, actualiza DATABASE_URL/DATABASE_URL_TEST para que coincidan.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stock_manager

# Obligatorio: minimo 32 caracteres. Nunca versionar el valor real.
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
# Segundos de vida del JWT
JWT_EXPIRES_IN=3600
CORS_ORIGIN="http://localhost:3000"
BCRYPT_ROUNDS=10

# Solo para `npm run prisma:seed` (primer ADMIN). Opcionales.
# Si no se definen, se crearán solo productos y movimientos de prueba
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia-esta-contrasena"
